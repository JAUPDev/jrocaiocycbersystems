### 3. App routing

**`src/App.tsx`**

```tsx
import React from "react";
import Navbar from "./components/Navbar";
import Footer from "./components/Footer";
import Home from "./pages/Home";
import Contact from "./pages/Contact";
import FAQ from "./pages/FAQ";
import Privacy from "./pages/Privacy";
import Terms from "./pages/Terms";
import CasesDashboard from "./pages/CasesDashboard";
import CaseDetail from "./pages/CaseDetail";

const App: React.FC = () => {
  const path = window.location.pathname;

  let Page: React.FC;

  if (path === "/contact") Page = Contact;
  else if (path === "/faq") Page = FAQ;
  else if (path === "/privacy") Page = Privacy;
  else if (path === "/terms") Page = Terms;
  else if (path === "/cases") Page = CasesDashboard;
  else if (path.startsWith("/cases/")) Page = CaseDetail;
  else Page = Home;

  return (
    <>
      <Navbar />
      <Page />
      <Footer />
    </>
  );
};

export default App;
```

