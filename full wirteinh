### 4. Cases dashboard (list view)

**`src/pages/CasesDashboard.tsx`**

```tsx
import React, { useEffect, useState } from "react";

interface Case {
  id: number;
  title: string;
  description: string;
  status: string;
  created_at: string;
}

const CasesDashboard: React.FC = () => {
  const [cases, setCases] = useState<Case[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadCases = async () => {
    try {
      setLoading(true);
      setError(null);

      const res = await fetch("http://localhost:8000/api/v1/cases", {
        headers: {
          // if you use JWT, drop it here:
          // Authorization: `Bearer ${localStorage.getItem("jroc_token") || ""}`,
        },
      });

      if (!res.ok) {
        throw new Error(`Failed to load cases (${res.status})`);
      }

      const data = await res.json();
      setCases(data);
    } catch (e: any) {
      setError(e.message || "Error loading cases");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadCases();
  }, []);

  return (
    <div className="container">
      <h2>Cases Dashboard</h2>
      <p>
        These are the intelligence cases created by the system—each one a record of OSINT, legal context,
        and AI‑generated summaries. Use them as references, not as final answers.
      </p>

      {loading && <p style={{ marginTop: 16 }}>Loading cases…</p>}
      {error && <p style={{ marginTop: 16, color: "#ff6b6b" }}>{error}</p>}

      {!loading && !error && cases.length === 0 && (
        <p style={{ marginTop: 16 }}>No cases yet. Run a core intel cycle to create one.</p>
      )}

      {!loading && !error && cases.length > 0 && (
        <div style={{ marginTop: 24 }}>
          {cases.map((c) => (
            <div
              key={c.id}
              style={{
                padding: 16,
                border: "1px solid #1a2330",
                borderRadius: 6,
                marginBottom: 12,
              }}
            >
              <div style={{ display: "flex", justifyContent: "space-between" }}>
                <div>
                  <strong>{c.title}</strong>
                  <div style={{ fontSize: 12, color: "#7aa8ff" }}>
                    Status: {c.status} · Created: {new Date(c.created_at).toLocaleString()}
                  </div>
                </div>
                <a href={`/cases/${c.id}`} style={{ fontSize: 13 }}>
                  View details →
                </a>
              </div>

              <p style={{ marginTop: 8, fontSize: 14 }}>{c.description}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

export default CasesDashboard;
```

