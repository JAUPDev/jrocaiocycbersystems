### 1. Use the new models in your Core Intelligence Engine

In your existing `core_intel/engine.py`, swap to the Cybersystems models:

```python
from database import SessionLocal
from models import Case, Action, Result, OsintScan, LegalCase
from services.osint.engine import run_osint
from services.legal.engine import create_legal_case, LegalRequest
from services.ai.core import ai_generate

async def run_core_intel(req):
    db = SessionLocal()

    # 1) Create Case
    case = Case(
        title=f"Intel: {req.query}",
        description=f"Mode: {req.mode}",
        org_id=req.org_id,
        owner_id=req.user_id,
    )
    db.add(case)
    db.commit()
    db.refresh(case)

    # 2) OSINT Action
    osint_action = Action(
        case_id=case.id,
        tool_name="osint_scan",
        category="osint",
        input_payload=req.query,
    )
    db.add(osint_action)
    db.commit()
    db.refresh(osint_action)

    osint_data = await run_osint(req.query)

    osint_scan = OsintScan(
        action_id=osint_action.id,
        query=req.query,
        source="external",
        abstract=osint_data.get("abstract"),
        related=json.dumps(osint_data.get("related", [])),
    )
    db.add(osint_scan)

    osint_summary = await ai_generate(
        prompt=f"Summarize OSINT findings:\n{json.dumps(osint_data)}"
    )

    osint_result = Result(
        action_id=osint_action.id,
        summary_text=osint_summary,
        raw_data=json.dumps(osint_data),
    )
    db.add(osint_result)
    db.commit()
    db.refresh(osint_result)

    # 3) Optional Legal
    legal_payload = None
    if req.mode in ("legal", "hybrid") and req.legal:
        legal_action = Action(
            case_id=case.id,
            tool_name="legal_case",
            category="legal",
            input_payload=json.dumps(req.legal),
        )
        db.add(legal_action)
        db.commit()
        db.refresh(legal_action)

        legal_req = LegalRequest(
            case_title=req.legal.get("case_title", f"Legal for {req.query}"),
            description=req.legal.get("description", "Auto-generated legal context."),
            category=req.legal.get("category", "compliance"),
        )
        legal_case_data = create_legal_case(legal_req)

        legal_case = LegalCase(
            action_id=legal_action.id,
            case_title=legal_req.case_title,
            description=legal_req.description,
            category=legal_req.category,
        )
        db.add(legal_case)

        legal_summary = await ai_generate(
            prompt=f"Summarize legal context:\n{json.dumps(legal_case_data)}"
        )

        legal_result = Result(
            action_id=legal_action.id,
            summary_text=legal_summary,
            raw_data=json.dumps(legal_case_data),
        )
        db.add(legal_result)
        db.commit()
        db.refresh(legal_result)

        legal_payload = legal_case_data

    # 4) Global summary
    combined_text = "\n\n".join(
        [
            f"[OSINT] {osint_result.summary_text}",
            f"[LEGAL] {legal_result.summary_text}" if req.mode in ("legal", "hybrid") and req.legal else "",
        ]
    )

    global_summary = await ai_generate(
        prompt=f"Create a unified intelligence brief:\n{combined_text}"
    )

    db.close()

    return {
        "case_id": case.id,
        "query": req.query,
        "mode": req.mode,
        "osint": osint_data,
        "legal": legal_payload,
        "global_summary": global_summary,
    }
```

