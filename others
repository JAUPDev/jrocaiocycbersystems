// src/domain/missions/mission.service.ts
import { prisma, } from "../../config/db";
import { MissionStatus } from "@prisma/client";
import { CreateMissionInput, MissionDTO } from "./mission.types";
import { logger } from "../../shared/logger";

export class MissionService {
  async createMission(input: CreateMissionInput): Promise<MissionDTO> {
    const mission = await prisma.mission.create({
      data: {
        name: input.name,
        description: input.description,
        status: MissionStatus.CREATED,
      },
    });

    logger.info("Mission created", { missionId: mission.id });

    return mission;
  }

  async updateStatus(id: string, status: MissionStatus): Promise<MissionDTO> {
    const mission = await prisma.mission.update({
      where: { id },
      data: { status },
    });

    logger.info("Mission status updated", { missionId: id, status });

    return mission;
  }

  async getMission(id: string): Promise<MissionDTO | null> {
    return prisma.mission.findUnique({
      where: { id },
      include: { tasks: true },
    }) as any;
  }

  async listMissions(): Promise<MissionDTO[]> {
    return prisma.mission.findMany({
      orderBy: { createdAt: "desc" },
    }) as any;
  }
}

export const missionService = new MissionService();
