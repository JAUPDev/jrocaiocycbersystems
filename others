import { prisma } from "../../config/db";
import { AgentRole } from "@prisma/client";
import { CreateAgentInput, AgentDTO } from "./agent.types";
import { logger } from "../../shared/logger";

export class AgentService {
  async createAgent(input: CreateAgentInput): Promise<AgentDTO> {
    const agent = await prisma.agent.create({
      data: {
        name: input.name,
        role: input.role,
      },
    });

    logger.info("Agent created", { agentId: agent.id, role: agent.role });

    return agent;
  }

  async listAgents(role?: AgentRole): Promise<AgentDTO[]> {
    return prisma.agent.findMany({
      where: role ? { role } : {},
      orderBy: { createdAt: "asc" },
    }) as any;
  }

  async getAvailableAgent(role: AgentRole): Promise<AgentDTO | null> {
    const agent = await prisma.agent.findFirst({
      where: { role, active: true },
      orderBy: { createdAt: "asc" },
    });

    return agent as any;
  }

  async setActive(agentId: string, active: boolean): Promise<AgentDTO> {
    const agent = await prisma.agent.update({
      where: { id: agentId },
      data: { active },
    });

    logger.info("Agent active state updated", { agentId, active });

    return agent;
  }
}

