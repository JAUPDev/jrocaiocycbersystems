// src/domain/tasks/task.service.ts
import { prisma } from "../../config/db";
import { TaskStatus } from "@prisma/client";
import { CreateTaskInput, TaskDTO } from "./task.types";
import { logger } from "../../shared/logger";

export class TaskService {
  async createTask(input: CreateTaskInput): Promise<TaskDTO> {
    const task = await prisma.task.create({
      data: {
        missionId: input.missionId,
        title: input.title,
        description: input.description,
        agentId: input.agentId,
        status: TaskStatus.PENDING,
      },
    });

    logger.info("Task created", { taskId: task.id, missionId: input.missionId });

    return task;
  }

  async assignTask(taskId: string, agentId: string): Promise<TaskDTO> {
    const task = await prisma.task.update({
      where: { id: taskId },
      data: {
        agentId,
        status: TaskStatus.ASSIGNED,
      },
    });

    logger.info("Task assigned", { taskId, agentId });

    return task;
  }

  async updateStatus(taskId: string, status: TaskStatus): Promise<TaskDTO> {
    const task = await prisma.task.update({
      where: { id: taskId },
      data: { status },
    });

    logger.info("Task status updated", { taskId, status });

    return task;
  }

  async listTasksByMission(missionId: string): Promise<TaskDTO[]> {
    return prisma.task.findMany({
      where: { missionId },
      orderBy: { createdAt: "asc" },
    }) as any;
  }
}

export const taskService = new TaskService();
