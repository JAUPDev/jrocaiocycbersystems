API routes
Missions routes
ts
// src/api/missions.routes.ts
import { Router } from "express";
import { orchestratorService } from "../domain/orchestrator/orchestrator.service";
import { missionService } from "../domain/missions/mission.service";

const router = Router();

// POST /missions/build
router.post("/build", async (req, res, next) => {
  try {
    const { name, description } = req.body;
    const mission = await orchestratorService.createBuildMission({ name, description });
    res.status(201).json(mission);
  } catch (err) {
    next(err);
  }
});

// GET /missions/:id/status
router.get("/:id/status", async (req, res, next) => {
  try {
    const status = await orchestratorService.getMissionStatus(req.params.id);
    res.json(status);
  } catch (err) {
    next(err);
  }
});

// GET /missions
router.get("/", async (req, res, next) => {
  try {
    const missions = await missionService.listMissions();
    res.json(missions);
  } catch (err) {
    next(err);
  }
});

export default router;
