Prisma schema (missions, tasks, agents)
ts
// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MissionStatus {
  CREATED
  PLANNING
  IN_PROGRESS
  AWAITING_APPROVAL
  READY_TO_DEPLOY
  COMPLETED
  PAUSED
  FAILED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum AgentRole {
  RESEARCH
  PRODUCT
  UI_UX
  FRONTEND
  BACKEND
  DATABASE
  QA
}

model Mission {
  id           String        @id @default(cuid())
  name         String
  description  String?
  status       MissionStatus @default(CREATED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
}

model Task {
  id           String     @id @default(cuid())
  missionId    String
  mission      Mission    @relation(fields: [missionId], references: [id])
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  agentId      String?
  agent        Agent?     @relation(fields: [agentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Agent {
  id        String    @id @default(cuid())
  name      String
  role      AgentRole
  active    Boolean   @default(true)
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
