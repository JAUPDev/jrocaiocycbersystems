Orchestrator Service (engine + pipeline)
This is where Orchestrator Architecture + Mission/Task Engine + Swarm Agent System meet.

ts
// src/domain/orchestrator/orchestrator.service.ts
import { missionService } from "../missions/mission.service";
import { taskService } from "../tasks/task.service";
import { agentService } from "../agents/agent.service";
import { MissionStatus, TaskStatus, AgentRole } from "@prisma/client";
import { BuildMissionInput, OrchestratorStatus } from "./orchestrator.types";
import { logger } from "../../shared/logger";

export class OrchestratorService {
  /**
   * User: "J-ROC, build me this app."
   * Creates mission + initial task blueprint.
   */
  async createBuildMission(input: BuildMissionInput) {
    // 1. Create mission
    const mission = await missionService.createMission({
      name: input.name,
      description: input.description,
    });

    // 2. Move mission to PLANNING
    await missionService.updateStatus(mission.id, MissionStatus.PLANNING);

    // 3. Generate initial tasks (pipeline: intent → blueprint → tasks)
    // Example: basic wholesale marketplace blueprint
    const blueprintTasks = [
      {
        title: "Research: wholesale marketplace requirements",
        description: "Gather domain requirements, user roles, and core flows.",
        role: AgentRole.RESEARCH,
      },
      {
        title: "Product: define feature set and roadmap",
        description: "Translate research into features, MVP scope, and roadmap.",
        role: AgentRole.PRODUCT,
      },
      {
        title: "UI/UX: design core screens and flows",
        description: "Create wireframes for onboarding, catalog, cart, checkout, admin.",
        role: AgentRole.UI_UX,
      },
      {
        title: "Frontend: implement UI components",
        description: "Build React components for main flows.",
        role: AgentRole.FRONTEND,
      },
      {
        title: "Backend: design APIs and services",
        description: "Define endpoints, business logic, and integration points.",
        role: AgentRole.BACKEND,
      },
      {
        title: "Database: design schema",
        description: "Model products, orders, users, permissions.",
        role: AgentRole.DATABASE,
      },
      {
        title: "QA: test core flows",
        description: "Validate main user journeys and edge cases.",
        role: AgentRole.QA,
      },
    ];

    for (const bt of blueprintTasks) {
      const agent = await agentService.getAvailableAgent(bt.role);

      await taskService.createTask({
        missionId: mission.id,
        title: bt.title,
        description: bt.description,
        agentId: agent?.id,
      });
    }

    logger.info("Build mission initialized with blueprint tasks", {
      missionId: mission.id,
      taskCount: blueprintTasks.length,
    });

    // 4. Move mission to IN_PROGRESS
    await missionService.updateStatus(mission.id, MissionStatus.IN_PROGRESS);

    return mission;
  }

  /**
   * User: "J-ROC, what's the status?"
   * Returns a human-friendly summary of mission + tasks.
   */
  async getMissionStatus(missionId: string): Promise<OrchestratorStatus> {
    const mission = await missionService.getMission(missionId);
    if (!mission) {
      return {
        mission: null,
        summary: "No mission found.",
        pendingApprovals: 0,
        readyToDeploy: false,
      };
    }

    const tasks = await taskService.listTasksByMission(missionId);

    const pendingApprovals = tasks.filter(
      (t) => t.status === TaskStatus.AWAITING_APPROVAL
    ).length;

    const completed = tasks.filter((t) => t.status === TaskStatus.COMPLETED).length;
    const total = tasks.length;

    const readyToDeploy =
      mission.status === MissionStatus.READY_TO_DEPLOY ||
      (completed === total && total > 0);

    const summary = `Mission "${mission.name}" is ${mission.status}. ${completed}/${total} tasks completed. ${pendingApprovals} awaiting approval.`;

    return {
      mission: mission as any,
      summary,
      pendingApprovals,
      readyToDeploy,
    };
  }

  /**
   * Pipeline step: mark tasks as awaiting approval when agents finish.
   */
  async markTaskAwaitingApproval(taskId: string) {
    await taskService.updateStatus(taskId, TaskStatus.AWAITING_APPROVAL);
  }

  /**
   * Pipeline step: approve task and check if mission can move forward.
   */
  async approveTask(taskId: string, missionId: string) {
    await taskService.updateStatus(taskId, TaskStatus.COMPLETED);

    const tasks = await taskService.listTasksByMission(missionId);
    const allCompleted = tasks.every((t) => t.status === TaskStatus.COMPLETED);

    if (allCompleted) {
      await missionService.updateStatus(missionId, MissionStatus.READY_TO_DEPLOY);
      logger.info("Mission ready to deploy", { missionId });
    }
  }

  /**
   * Pause / resume mission.
   */
  async pauseMission(missionId: string) {
    await missionService.updateStatus(missionId, MissionStatus.PAUSED);
  }

  async resumeMission(missionId: string) {
    await missionService.updateStatus(missionId, MissionStatus.IN_PROGRESS);
  }
}

export const orchestratorService = new OrchestratorService();
